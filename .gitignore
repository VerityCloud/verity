deployweb.sh

# "Compiled" documentation
verity.pdf
cci.pdf

# macOS
.DS_Store
.AppleDouble
.LSOverride
Archive.zip

# Icon must end with two \r
Icon

# Thumbnails
._*


# OS generated foo
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Python
*.py[cod]
*.pyo
*.pyc
__pycache__
*.so
*.egg
*.egg-info/
dist/
build/
distweb/
node_modules/
logo/
*~

# IDEs and editors
/.idea
/.vscode
*.swp
*.swo
*.swn
*.bak
*.py,cover
*.code-workspace

# AI foo for developers who are too lazy to code themselves
.aider*
aider
.codex

